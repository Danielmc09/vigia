# Meta Model API (tier Standard)
MODEL_API_KEY=
MODEL_BACKEND=spark            # spark | glimmer
GLIMMER_BASE_URL=http://localhost:11434/v1
# Jev (opcional; mock si vacío)
JEV_API_KEY=
JEV_BACKEND=mock               # typesafe | openrouter | mock
# WhatsApp (Wazenda)
WAZENDA_BASE_URL=https://wazenda.com/api/v1/public
WAZENDA_API_KEY=
WAZENDA_LINE_ID=
WAZENDA_WEBHOOK_SECRET=
WAZENDA_NUMERO=
# Correo (capa 2)
RESEND_API_KEY=
CORREO_RECEPTOR=revisar@tu-dominio-vigia
# Cifrado (specs/16): 32 bytes base64 cada una; generar con `python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"`
VIGIA_KEK=
PII_HMAC_KEY=
# Infra
# App role (no superuser, no BYPASSRLS) and schema owner used only by migrations (D-023)
DATABASE_URL=postgresql://vigia_app:vigia_app@localhost:5432/vigia
MIGRATION_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vigia
# docker compose: passwords and host ports
POSTGRES_PASSWORD=postgres
APP_DB_PASSWORD=vigia_app
VIGIA_DB_PORT=5432
VIGIA_API_PORT=8000
REDIS_URL=redis://localhost:6379/0
VIGIA_MODO=dev                 # dev | eval | prod
# Topes
TOPE_CASOS_NEGOCIO_DIA=60
TOPE_CASOS_REMITENTE_DIA=20
ALERTA_PRESUPUESTO_USD=5
ALERTA_CSIRT_EMAIL=
# Observabilidad (specs/11): vacíos = apagado
METRICS_TOKEN=                 # ≥ 32 caracteres; sin token, /metrics da 404
SENTRY_DSN=
OPERADOR_TELEFONO=             # E.164; recibe las alertas del centinela
